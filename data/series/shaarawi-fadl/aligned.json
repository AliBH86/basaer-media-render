{
 "audioSec": 46.106,
 "phrases": [
  {
   "i": 0,
   "text": "اللهم يا حسيب وكفى بك حسيبا",
   "start": 0,
   "end": 3.82
  },
  {
   "i": 1,
   "text": "اللهم يا رقيب وكفى بك رقيبا",
   "start": 3.82,
   "end": 9.86
  },
  {
   "i": 2,
   "text": "لا يعزب عنك أصغر ذرة في السماوات ولا في الأرض",
   "start": 9.86,
   "end": 16.86
  },
  {
   "i": 3,
   "text": "ولا يعجزك شيء لإحاطة قدرتك",
   "start": 16.86,
   "end": 22.84
  },
  {
   "i": 4,
   "text": "فعاملنا اللهم بالفضل لا بالعدل",
   "start": 22.84,
   "end": 26.98
  },
  {
   "i": 5,
   "text": "وبالإحسان لا بالميزان",
   "start": 26.98,
   "end": 30.36
  },
  {
   "i": 6,
   "text": "وحسبنا من رحمتك التي وسعت كل شيء",
   "start": 30.36,
   "end": 35.9
  },
  {
   "i": 7,
   "text": "ما شكرناه من نعم ربوبيتك",
   "start": 35.9,
   "end": 40.8
  },
  {
   "i": 8,
   "text": "وما أطعناه من نعمة ألوهيتك",
   "start": 40.8,
   "end": 45.86
  }
 ],
